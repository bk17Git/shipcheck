# Shipcheck Server Environment Configuration Template
# Copy this file to .env and supply your API keys.

# Optional: Google Gemini API key for AI-generated explanations and remediation diffs.
# If omitted, Shipcheck falls back to deterministic static explanations.
GEMINI_API_KEY=

# Optional: GitHub Personal Access Token to raise REST API rate limits from 60/hr to 5,000/hr.
GITHUB_TOKEN=

# Optional: Server listening port (default: 3001)
PORT=3001
